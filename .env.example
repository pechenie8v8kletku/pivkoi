DATABASE_URL=sqlite:///./business_match.db
MODEL_API_MODE=mock
MOCK_API_BASE_URL=http://127.0.0.1:8010/v1
# Production example: postgresql+psycopg://user:password@localhost:5432/business_match
LLM_BASE_URL=https://your-gateway/v1
LLM_API_KEY=replace-me
# Exact model alias served by your private gateway; override if different.
LLM_MODEL=Qwen3.8-38B
EMBEDDING_BASE_URL=https://your-gateway/v1
EMBEDDING_API_KEY=replace-me
EMBEDDING_MODEL=Qwen3-Embedding-4B
# Optional exact URL; gateway reranking protocols differ. Contract: docs/integration.md
RERANK_URL=
RERANK_API_KEY=replace-me
RERANK_MODEL=bge-reranker-v2-m3
RERANK_ENABLED=true
RERANK_FEED_ENABLED=true
RANKER_MODE=linucb
LINUCB_REGULARIZATION=1.0
LINUCB_ALPHA=0.15
RANKER_PERSONAL_WEIGHT=0.5
PERSONAL_METADATA_SCALE=0.1
RANKER_RERANK_WEIGHT=0.35
RANKER_GRAPH_WEIGHT=0.1
RANKER_FRESHNESS_WEIGHT=0.03
RANKER_REGION_WEIGHT=0.02
DIVERSITY_WEIGHT=0.12
MAX_SEGMENT_SHARE=0.6
DIVERSITY_SCORE_TOLERANCE=0.2
RETRIEVAL_SCORE_TOLERANCE=0.1
MAX_ROLE_SHARE=0.6
MAX_PEER_SHARE=0.2
EXPLORATION_RATE=0.1
EXPLORATION_FRESHNESS_WEIGHT=1.0
FRESHNESS_HALF_LIFE_DAYS=14
# Protect service routes when exposing outside a trusted internal network.
SERVICE_API_KEY=

# Exact retrieval: memory bounds, not an ANN index.
CANDIDATE_LIMIT=150
# Behavioral retrieval: up to ten distinct, role-specific interests per client.
INTEREST_RETRIEVAL_ENABLED=true
INTEREST_MAX_VECTORS=10
INTEREST_CANDIDATES_PER_VECTOR=20
INTEREST_HALF_LIFE_DAYS=14
INTEREST_MIN_SUPPORT=0.2
INTEREST_MERGE_SIMILARITY=0.9
RETRIEVAL_CLIENT_BATCH_SIZE=128
RETRIEVAL_DOCUMENT_BATCH_SIZE=1024
RETRIEVAL_QUERY_BATCH_SIZE=64
QUERY_IMPORTANCE_WEIGHT=0.15
CARD_PRODUCT_LIMIT=3
CARD_PRODUCT_SCORE_TOLERANCE=0.1

# Observed business activity: configurable MVP priors, not calibrated probabilities.
BUSINESS_SIGNALS_ENABLED=true
BUSINESS_SIGNAL_BOOST=0.12
BUSINESS_SIGNAL_HALF_LIFE_DAYS=60
BUSINESS_SIGNAL_MAX_AGE_DAYS=365
BUSINESS_SIGNAL_MIN_CONFIDENCE=0.6
BUSINESS_SIGNAL_COMPLETED_WEIGHT=0.5
BUSINESS_SIGNAL_SOURCES_LIMIT=8

# Feature layout changes invalidate old personal state and old slates.
CONTENT_DIMENSIONS=32
CONTENT_PROJECTION_SEED=42
CATALOG_SIZE_SCALE=20
RANKER_MAX_OBSERVATIONS=1000
HISTORY_HALF_LIFE_DAYS=14
REWARD_OPEN=0.55
REWARD_LIKE=0.8
REWARD_CONTACT=1.0
REWARD_HIDE=0.0
REWARD_DWELL_MAX=0.35
DWELL_MIN_MS=2000
DWELL_SATURATION_MS=15000
BASELINE_CEILING=0.8
BASELINE_SLOPE=4.0
BASELINE_MIDPOINT=0.5

# Feedback windows and slate policy.
FEEDBACK_HISTORY_DAYS=60
HIDE_DURATION_DAYS=7
IMPRESSION_DECAY_DAYS=1
EVENT_FUTURE_TOLERANCE_SECONDS=300
SEGMENT_REPEAT_WEIGHT=0.25

# Directed global graph: configurable priors and event calibration.
GRAPH_PRIOR_RATE=0.12
GRAPH_PRIOR_STRENGTH=20
GRAPH_HALF_LIFE_DAYS=60
GRAPH_NEGATIVE_WEIGHT=2
GRAPH_SCORE_SCALE=0.12
GRAPH_REWARD_DWELL=0.12
GRAPH_REWARD_OPEN=0.35
GRAPH_REWARD_LIKE=0.65
GRAPH_REWARD_CONTACT=1.0
