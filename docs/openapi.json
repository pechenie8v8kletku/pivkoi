{
  "openapi": "3.1.0",
  "info": {
    "title": "Business Match",
    "description": "Adaptive B2B recommendations. Integration: docs/integration.md",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/v1/clients/{client_id}": {
      "put": {
        "summary": "Upsert",
        "operationId": "upsert_v1_clients__client_id__put",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "client_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Client Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClientInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "Profile",
        "operationId": "profile_v1_clients__client_id__get",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "client_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Client Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/feed": {
      "post": {
        "summary": "Feed",
        "operationId": "feed_v1_feed_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecommendRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecommendationResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    },
    "/v1/search": {
      "post": {
        "summary": "Search",
        "operationId": "search_v1_search_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecommendRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecommendationResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    },
    "/v1/events": {
      "post": {
        "summary": "Events",
        "operationId": "events_v1_events_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FeedbackBatch"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "BusinessContext": {
        "properties": {
          "source_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Source Id"
          },
          "source_sequence": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Source Sequence"
          },
          "records": {
            "items": {
              "$ref": "#/components/schemas/BusinessRecord"
            },
            "type": "array",
            "maxItems": 200,
            "title": "Records"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "source_id",
          "source_sequence"
        ],
        "title": "BusinessContext"
      },
      "BusinessRecord": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Id"
          },
          "kind": {
            "type": "string",
            "enum": [
              "contract",
              "transfer"
            ],
            "title": "Kind"
          },
          "role": {
            "type": "string",
            "enum": [
              "buyer",
              "seller",
              "unknown"
            ],
            "title": "Role",
            "default": "unknown"
          },
          "subject": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Subject"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "completed",
              "cancelled",
              "pending",
              "settled",
              "refunded"
            ],
            "title": "Status"
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time",
            "title": "Occurred At"
          },
          "valid_until": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Valid Until"
          },
          "transaction_group_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Transaction Group Id"
          },
          "purpose": {
            "type": "string",
            "enum": [
              "trade",
              "noncommercial",
              "unknown"
            ],
            "title": "Purpose",
            "default": "unknown"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "kind",
          "subject",
          "status",
          "occurred_at"
        ],
        "title": "BusinessRecord"
      },
      "ClientInput": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Id"
          },
          "name": {
            "type": "string",
            "maxLength": 300,
            "minLength": 1,
            "title": "Name"
          },
          "description": {
            "type": "string",
            "maxLength": 12000,
            "title": "Description",
            "default": ""
          },
          "segment": {
            "type": "string",
            "maxLength": 200,
            "title": "Segment",
            "default": "unknown"
          },
          "region": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Region"
          },
          "city": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "City"
          },
          "explicit_needs": {
            "items": {
              "type": "string",
              "maxLength": 4000,
              "minLength": 1
            },
            "type": "array",
            "maxItems": 30,
            "title": "Explicit Needs"
          },
          "products": {
            "items": {
              "$ref": "#/components/schemas/Product"
            },
            "type": "array",
            "maxItems": 5000,
            "title": "Products"
          },
          "active": {
            "type": "boolean",
            "title": "Active",
            "default": true
          },
          "business_context": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/BusinessContext"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "title": "ClientInput",
        "description": "Full current snapshot; omitted products are deleted from this client's catalog."
      },
      "EventKind": {
        "type": "string",
        "enum": [
          "impression",
          "dwell",
          "open",
          "like",
          "unlike",
          "contact",
          "hide"
        ],
        "title": "EventKind"
      },
      "FeedbackBatch": {
        "properties": {
          "events": {
            "items": {
              "$ref": "#/components/schemas/FeedbackEvent"
            },
            "type": "array",
            "maxItems": 100,
            "minItems": 1,
            "title": "Events"
          }
        },
        "type": "object",
        "required": [
          "events"
        ],
        "title": "FeedbackBatch"
      },
      "FeedbackEvent": {
        "properties": {
          "event_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Event Id"
          },
          "request_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Request Id"
          },
          "client_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Client Id"
          },
          "target_client_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Target Client Id"
          },
          "kind": {
            "$ref": "#/components/schemas/EventKind"
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time",
            "title": "Occurred At"
          },
          "visible_fraction": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Visible Fraction",
            "default": 0
          },
          "dwell_ms": {
            "type": "integer",
            "maximum": 3600000.0,
            "minimum": 0.0,
            "title": "Dwell Ms",
            "default": 0
          },
          "product_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Product Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "event_id",
          "request_id",
          "client_id",
          "target_client_id",
          "kind"
        ],
        "title": "FeedbackEvent"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Intent": {
        "type": "string",
        "enum": [
          "supplier",
          "buyer",
          "partner",
          "peer"
        ],
        "title": "Intent"
      },
      "Product": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Id"
          },
          "name": {
            "type": "string",
            "maxLength": 300,
            "minLength": 1,
            "title": "Name"
          },
          "description": {
            "type": "string",
            "maxLength": 4000,
            "title": "Description",
            "default": ""
          },
          "category": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Category"
          },
          "stock": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Stock"
          },
          "price": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Price"
          },
          "unit": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ],
            "title": "Unit"
          },
          "active": {
            "type": "boolean",
            "title": "Active",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "title": "Product"
      },
      "ProductMatch": {
        "properties": {
          "product": {
            "$ref": "#/components/schemas/Product"
          },
          "score": {
            "type": "number",
            "title": "Score"
          }
        },
        "type": "object",
        "required": [
          "product",
          "score"
        ],
        "title": "ProductMatch"
      },
      "RecommendRequest": {
        "properties": {
          "client_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Client Id"
          },
          "limit": {
            "type": "integer",
            "maximum": 50.0,
            "minimum": 1.0,
            "title": "Limit",
            "default": 20
          },
          "query": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1000,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Query"
          },
          "region": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Region"
          },
          "city": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "City"
          },
          "intent": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Intent"
              },
              {
                "type": "null"
              }
            ]
          },
          "exclude_client_ids": {
            "items": {
              "type": "string",
              "maxLength": 128,
              "minLength": 1
            },
            "type": "array",
            "maxItems": 1000,
            "title": "Exclude Client Ids"
          },
          "seed": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Seed"
          }
        },
        "type": "object",
        "required": [
          "client_id"
        ],
        "title": "RecommendRequest"
      },
      "Recommendation": {
        "properties": {
          "client_id": {
            "type": "string",
            "title": "Client Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "segment": {
            "type": "string",
            "title": "Segment"
          },
          "region": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Region"
          },
          "city": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "City"
          },
          "intent": {
            "$ref": "#/components/schemas/Intent"
          },
          "score": {
            "type": "number",
            "title": "Score"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          },
          "matched_need": {
            "type": "string",
            "title": "Matched Need"
          },
          "matched_text": {
            "type": "string",
            "title": "Matched Text"
          },
          "products": {
            "items": {
              "$ref": "#/components/schemas/ProductMatch"
            },
            "type": "array",
            "title": "Products"
          },
          "exploration": {
            "type": "boolean",
            "title": "Exploration",
            "default": false
          },
          "insights": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Insights"
          }
        },
        "type": "object",
        "required": [
          "client_id",
          "name",
          "segment",
          "region",
          "city",
          "intent",
          "score",
          "reason",
          "matched_need",
          "matched_text",
          "products"
        ],
        "title": "Recommendation"
      },
      "RecommendationResponse": {
        "properties": {
          "request_id": {
            "type": "string",
            "title": "Request Id"
          },
          "mode": {
            "type": "string",
            "enum": [
              "feed",
              "search"
            ],
            "title": "Mode"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/Recommendation"
            },
            "type": "array",
            "title": "Items"
          },
          "policy_version": {
            "type": "string",
            "title": "Policy Version",
            "default": "anchored-multivector-v1"
          },
          "diagnostics": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "string"
                }
              ]
            },
            "type": "object",
            "title": "Diagnostics"
          }
        },
        "type": "object",
        "required": [
          "request_id",
          "mode",
          "items"
        ],
        "title": "RecommendationResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "APIKeyHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    }
  }
}
